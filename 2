#include <iostream>
#include <vector>

using namespace std;

int main() {
    int rows, cols;
    cout << "Введіть кількість рядків та стовпців масиву: ";
    cin >> rows >> cols;

    if (rows <= 0 || cols <= 0) {
        cout << "Помилка: розміри масиву мають бути натуральними числами." << endl;
        return 1;
    }

    vector<vector<int>> arr(rows, vector<int>(cols));
    cout << "Введіть елементи масиву (" << rows << "x" << cols << "):" << endl;
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            cin >> arr[i][j];
        }
    }

    int valid_rows_count = 0;

    for (int i = 0; i < rows; ++i) {
        int even_in_row = 0;
        for (int j = 0; j < cols; ++j) {
            if (arr[i][j] % 2 == 0) {
                ++even_in_row;
            }
        }
        if (even_in_row == 2) {
            ++valid_rows_count;
        }
    }

    cout << "Кількість рядків, у яких є два парних елементи: " << valid_rows_count << endl;

    return 0;
}
